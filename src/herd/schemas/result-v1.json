{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "herd/result-v1.json",
  "title": "HERD run result, version 1.x",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "run_id", "exp_id", "label", "created_utc", "config", "config_sha256",
               "metric_definitions", "arms", "contrasts", "checks", "failures", "timing"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "kind": {"const": "herd-result"},
    "run_id": {"type": "string", "pattern": "^EXP-[0-9]{3}-R[0-9]{3}$"},
    "exp_id": {"type": "string", "pattern": "^EXP-[0-9]{3}$"},
    "label": {"enum": ["exploratory", "confirmatory"]},
    "created_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
    "config": {"type": "object"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "metric_definitions": {"type": "object", "additionalProperties": {"type": "string"}},
    "arms": {"type": "array", "items": {"$ref": "#/$defs/arm"}},
    "contrasts": {"type": "array", "items": {"$ref": "#/$defs/contrast"}},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "failures": {"type": "array", "items": {
      "type": "object", "required": ["variation", "cell", "seed", "error"],
      "properties": {"variation": {"type": "string"}, "cell": {"$ref": "#/$defs/cell"},
                     "seed": {"type": "integer"}, "error": {"type": "string"}}}},
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["simulation_s", "analysis_s", "agent_decisions", "seconds_per_1000_decisions", "per_cell"],
      "properties": {
        "simulation_s": {"type": "number", "minimum": 0},
        "analysis_s": {"type": "number", "minimum": 0},
        "agent_decisions": {"type": "integer", "minimum": 0},
        "seconds_per_1000_decisions": {"type": "number", "minimum": 0},
        "per_cell": {"type": "array", "items": {
          "type": "object", "required": ["variation", "cell", "seconds", "episodes"],
          "properties": {"variation": {"type": "string"}, "cell": {"$ref": "#/$defs/cell"},
                         "seconds": {"type": "number", "minimum": 0}, "episodes": {"type": "integer", "minimum": 1}}}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cell": {
      "type": "object", "additionalProperties": false, "required": ["q", "network", "v", "n_agents", "tie_rule"],
      "properties": {
        "q": {"type": "number", "minimum": 0.5, "maximum": 1},
        "network": {"type": "string", "pattern": "^(complete|window-[1-9][0-9]*)$"},
        "v": {"type": "number", "minimum": 0, "maximum": 1},
        "n_agents": {"type": "integer", "minimum": 1},
        "tie_rule": {"enum": ["own", "coin"]}
      }
    },
    "summary": {
      "type": "object", "required": ["mean", "sd", "se", "ci_low", "ci_high", "n"],
      "properties": {"mean": {"type": "number"}, "sd": {"type": "number", "minimum": 0}, "se": {"type": "number", "minimum": 0},
                     "ci_low": {"type": "number"}, "ci_high": {"type": "number"}, "n": {"type": "integer", "minimum": 2}}
    },
    "arm": {
      "type": "object", "additionalProperties": false,
      "required": ["variation", "rule", "cell", "n_episodes", "seeds", "metrics", "per_seed", "accuracy_histogram", "near_ties", "runtime_s"],
      "properties": {
        "variation": {"type": "string"},
        "rule": {"enum": ["independent", "bayesian", "imitation"]},
        "cell": {"$ref": "#/$defs/cell"},
        "n_episodes": {"type": "integer", "minimum": 2},
        "seeds": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/summary"}},
        "per_seed": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "number"}}},
        "accuracy_histogram": {"type": "object", "additionalProperties": false, "required": ["edges", "counts"],
          "properties": {"edges": {"type": "array", "items": {"type": "number"}}, "counts": {"type": "array", "items": {"type": "integer", "minimum": 0}}}},
        "near_ties": {"type": "integer", "minimum": 0},
        "runtime_s": {"type": "number", "minimum": 0}
      }
    },
    "contrast": {
      "type": "object", "additionalProperties": false,
      "required": ["variation", "rule", "control", "cell", "metric", "mean", "sd", "se", "ci_low", "ci_high", "n",
                   "degenerate", "t", "p_value", "p_holm", "per_seed_mean"],
      "properties": {
        "variation": {"type": "string"},
        "rule": {"enum": ["bayesian", "imitation"]},
        "control": {"const": "independent"},
        "cell": {"$ref": "#/$defs/cell"},
        "metric": {"const": "accuracy"},
        "mean": {"type": "number"}, "sd": {"type": "number", "minimum": 0}, "se": {"type": "number", "minimum": 0},
        "ci_low": {"type": "number"}, "ci_high": {"type": "number"}, "n": {"type": "integer", "minimum": 2},
        "degenerate": {"type": "boolean"},
        "t": {"type": ["number", "null"]},
        "p_value": {"type": "number", "minimum": 0, "maximum": 1},
        "p_holm": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "holm_family": {"type": "boolean"},
        "boot_ci_low": {"type": "number"}, "boot_ci_high": {"type": "number"},
        "per_seed_mean": {"type": "array", "items": {"type": "number"}}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "passed", "detail"],
      "properties": {
        "id": {"type": "string", "pattern": "^C[0-9]+$"},
        "name": {"type": "string"},
        "variation": {"type": "string"},
        "cell": {"$ref": "#/$defs/cell"},
        "rule": {"type": "string"},
        "passed": {"type": "boolean"},
        "observed": {"type": ["number", "string", "null"]},
        "expected": {"type": ["number", "string", "null"]},
        "detail": {"type": "string"}
      }
    }
  }
}
