{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "herd/config-v1.json",
  "title": "HERD experiment configuration, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_version", "exp_id", "run_id", "label", "description", "rules", "q", "networks",
               "visibility", "variations", "seeds", "episodes_per_seed", "bootstrap", "verification",
               "output_dir", "raw_dir"],
  "properties": {
    "config_version": {"const": "1"},
    "exp_id": {"type": "string", "pattern": "^EXP-[0-9]{3}$"},
    "run_id": {"type": "string", "pattern": "^EXP-[0-9]{3}-R[0-9]{3}$"},
    "label": {"enum": ["exploratory", "confirmatory"]},
    "description": {"type": "string", "minLength": 1},
    "rules": {"type": "array", "minItems": 1, "items": {"enum": ["independent", "bayesian", "imitation"]}},
    "q": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0.5, "maximum": 0.999999}},
    "networks": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(complete|window-[1-9][0-9]*)$"}},
    "visibility": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "variations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "tie_rule", "n_agents"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "tie_rule": {"enum": ["own", "coin"]},
          "n_agents": {"type": "integer", "minimum": 1}
        }
      }
    },
    "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "episodes_per_seed": {"type": "integer", "minimum": 2},
    "bootstrap": {
      "type": "object", "additionalProperties": false, "required": ["resamples", "seed"],
      "properties": {"resamples": {"type": "integer", "minimum": 0}, "seed": {"type": "integer", "minimum": 0}}
    },
    "verification": {"type": "boolean"},
    "output_dir": {"type": "string", "minLength": 1},
    "raw_dir": {"type": "string", "minLength": 1}
  }
}
